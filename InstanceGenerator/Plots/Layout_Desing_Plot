import random
from typing import List, Tuple
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import math

random.seed(42)

# Rechteck: (x, y, width, height)
Rect = Tuple[int, int, int, int]

def split_rect(rect: Rect, min_width=2, min_height=3) -> Tuple[Rect, Rect]:
    x, y, w, h = rect

    # Prüfe, ob ein Split überhaupt möglich ist
    can_split_horizontally = w > 2 * min_width
    can_split_vertically = h > 2 * min_height

    if can_split_horizontally and can_split_vertically:
        split_vertical = random.choice([True, False])
    elif can_split_horizontally:
        split_vertical = True
    elif can_split_vertically:
        split_vertical = False
    else:
        # Nicht teilbar
        return rect, None

    if split_vertical:
        # Wähle Split-Punkt, sodass beide Seiten >= min_width
        split = random.randint(min_width, w - min_width)
        r1 = (x, y, split, h)
        r2 = (x + split, y, w - split, h)
    else:
        # Split horizontal, beide Seiten >= min_height
        split = random.randint(min_height, h - min_height)
        r1 = (x, y, w, split)
        r2 = (x, y + split, w, h - split)

    return r1, r2

def generate_layout(cols=6, rows=10, min_boxes=2, max_boxes=5, min_width=2, min_height=3) -> List[Rect]: #hier sonst 100 und 30
    target_boxes = random.randint(min_boxes, max_boxes)
    rects = [(0, 0, cols, rows)]
    attempts = 0
    max_attempts = 50

    while len(rects) < target_boxes and attempts < max_attempts:
        attempts += 1
        idx = random.randrange(len(rects))
        rect = rects.pop(idx)
        
        r1, r2 = split_rect(rect, min_width, min_height)
        if r2 is None:
            # Rechteck nicht teilbar, zurücklegen
            rects.append(r1)
            continue
        rects.extend([r1, r2])

    return rects
