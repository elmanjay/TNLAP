def layout_to_tuple(layout: List[Rect]) -> Tuple[Rect, ...]:
    return tuple(sorted(layout))

unique_layouts = set()
all_layouts = []
while len(all_layouts) < 30: #hier je nachdem wie viele Layouts man erstellen will
    layout = generate_layout(min_width=2, min_height=3) #hier dann 30
    layout_key = layout_to_tuple(layout)

    if layout_key not in unique_layouts:
        unique_layouts.add(layout_key)
        all_layouts.append(layout)
print(all_layouts)

# nur zum plotten:
num_layouts = len(all_layouts)
cols = 5  # Anzahl der Spalten im Raster
rows = math.ceil(num_layouts / cols)

fig, axes = plt.subplots(rows, cols, figsize=(cols*3, rows*4))

# Flatten axes, falls es ein 2D Array ist
axes = axes.flatten()

for i, layout in enumerate(all_layouts):
    ax = axes[i]
    # Berechne Größe des Layouts für Limits
    max_x = max(x + w for (x, y, w, h) in layout)
    max_y = max(y + h for (x, y, w, h) in layout)
    
    ax.set_xlim(0, max_x)
    ax.set_ylim(0, max_y)
    ax.set_aspect('equal')
    ax.invert_yaxis()
    ax.axis('off')  # Achsen ausblenden

    for idx, (x, y, w, h) in enumerate(layout):
        rect = patches.Rectangle((x, y), w, h, edgecolor='black', facecolor=f"C{idx}", lw=2)
        ax.add_patch(rect)

# Leere Subplots ausblenden
for j in range(num_layouts, len(axes)):
    axes[j].axis('off')

plt.tight_layout()
plt.show()
